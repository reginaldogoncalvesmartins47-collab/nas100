// Structure VP + SMC (07/10/2026): Structure Volume Profile Setups (inalterado) + Order Blocks e FVG (regras do LuxAlgo SMC) + AVALIACAO DAS ZONAS (tabela).

//@version=6
indicator("Structure VP + SMC", "VP+SMC", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

const string GRP_SETUP = "Setup"
const string GRP_TRADE = "Trade"
const string GRP_HIST  = "History"
const string GRP_STYLE = "Style"

const string TT_SWING = "Pivot lookback used to detect swing points. Higher values return larger, slower market structure."
const string TT_BOS   = "Number of consecutive BOS in one direction required before an opposing CHoCH can trigger a setup."
const string TT_HTF   = "Setups are only allowed in the direction of the trend on the selected higher timeframe, measured with a 50 period EMA on confirmed values. Set to Off to trade both directions."
const string TT_GAP   = "Rejects setups whose trend leg contains a price gap larger than one ATR, such as a session or weekend gap. It also invalidates a pending entry before the session break, so price can never gap straight through the level."
const string TT_SIDE  = "Longs are only accepted when the POC is below price at the trigger bar, and shorts only when the POC is above it, so every entry is a retracement into the level rather than a breakout through it."
const string TT_VA    = "Percentage of the leg volume contained in the value area, which defines the value area high and low used as targets."
const string TT_ROWS  = "Number of price rows used to build the volume profile. Higher values give a more precise POC."
const string TT_MODE  = "Value Area: target at the value area high for longs, or low for shorts. ATR: target at a fixed ATR distance from the entry."
const string TT_TP    = "Target distance from the POC entry, in ATR. Only used when Target Mode is set to ATR."
const string TT_SL    = "Stop distance from the POC entry, in ATR. Used in both target modes."
const string TT_VOID  = "A pending entry stays valid until price reaches the POC. When enabled, a new CHoCH printing before the entry is touched cancels the setup. When disabled, the entry stays valid until it is reached or the expiry below elapses."
const string TT_EXP   = "Number of bars a pending entry stays valid when the CHoCH cancellation is disabled. Set to 0 to keep pending entries valid indefinitely."

const int    HTF_LEN      = 50
const float  GAP_ATR      = 1.0
const int    ATR_LEN      = 14
const int    PROFILE_W    = 25
const int    MAX_LOOKBACK = 300
const int    PROJECTION   = 30
const int    MIN_WIDTH    = 6

swingLen      = input.int(5, "Swing Length", minval = 2, maxval = 50, group = GRP_SETUP, tooltip = TT_SWING)
bosRequired   = input.int(3, "Consecutive BOS Required", minval = 1, maxval = 10, group = GRP_SETUP, tooltip = TT_BOS)
htfChoice     = input.string("Off", "HTF Trend Filter", options = ["Off", "15 min", "1 hour", "4 hours", "1 day"], group = GRP_SETUP, tooltip = TT_HTF)
useGapFilter  = input.bool(true, "Skip Setups Containing Gaps", group = GRP_SETUP, tooltip = TT_GAP)
useSideFilter = input.bool(true, "Require Retracement Into POC", group = GRP_SETUP, tooltip = TT_SIDE)
rowsCount     = input.int(30, "Profile Rows", minval = 5, maxval = 60, group = GRP_SETUP, tooltip = TT_ROWS)
vaPercent     = input.float(70, "Value Area %", minval = 10, maxval = 100, step = 5, group = GRP_SETUP, tooltip = TT_VA)

tpMode        = input.string("Value Area", "Target Mode", options = ["Value Area", "ATR"], group = GRP_TRADE, tooltip = TT_MODE)
tpMult        = input.float(2.0, "Target (ATR)", minval = 0.1, step = 0.1, group = GRP_TRADE, tooltip = TT_TP)
slMult        = input.float(1.0, "Stop (ATR)", minval = 0.1, step = 0.1, group = GRP_TRADE, tooltip = TT_SL)
voidOnChoch   = input.bool(true, "Cancel Pending Entry On New CHoCH", group = GRP_TRADE, tooltip = TT_VOID)
pendingExpiry = input.int(0, "Pending Entry Expiry (bars)", minval = 0, maxval = 500, group = GRP_TRADE, tooltip = TT_EXP)

maxSetups     = input.int(20, "Setups Kept On Chart", minval = 1, maxval = 100, group = GRP_HIST, tooltip = "Total number of past setups kept on the chart. Older ones are removed once this count is exceeded.")
maxProfiles   = input.int(5, "Profiles Kept Drawn", minval = 1, maxval = 20, group = GRP_HIST, tooltip = "Number of the most recent setups that keep their volume profile rows drawn. Older setups keep only their levels and boxes, which preserves drawing resources.")
showCancelled = input.bool(true, "Show Cancelled Setups", group = GRP_HIST, tooltip = "Keeps setups that were invalidated before their entry was reached on the chart, drawn in a faded style.")

showStructure = input.bool(true, "Show Structure", group = GRP_STYLE, tooltip = "Displays the BOS and CHoCH detections used by the logic.")
showStats     = input.bool(true, "Show Statistics", group = GRP_STYLE, tooltip = "Displays a table with the setups triggered and their outcome.")
bullCss       = input.color(#089981, "Bullish", inline = "dir", group = GRP_STYLE, tooltip = "Colors of bullish structure and targets.")
bearCss       = input.color(#f23645, "Bearish", inline = "dir", group = GRP_STYLE, tooltip = "Colors of bearish structure and targets.")
rowCss        = input.color(#5b9cf6, "Profile", inline = "vp", group = GRP_STYLE, tooltip = "Color of the profile rows outside the value area.")
vaCss         = input.color(#ff9800, "Value Area", inline = "vp", group = GRP_STYLE, tooltip = "Color of the profile rows inside the value area.")

bool   useHtf = htfChoice != "Off"
string htfTf  = switch htfChoice
    "15 min"  => "15"
    "1 hour"  => "60"
    "4 hours" => "240"
    "1 day"   => "1D"
    => "60"

type Setup
    array<box> rows
    box        frame
    box        tpBox
    box        slBox
    line       pocLine
    line       vahLine
    line       valLine
    label      info

method clearRows(Setup st) =>
    if not na(st) and not na(st.rows)
        for b in st.rows
            box.delete(b)
        st.rows.clear()
        box.delete(st.frame)
        line.delete(st.vahLine)
        line.delete(st.valLine)

method destroy(Setup st) =>
    if not na(st)
        st.clearRows()
        box.delete(st.tpBox)
        box.delete(st.slBox)
        line.delete(st.pocLine)
        label.delete(st.info)

method cancel(Setup st, int cancelBar, bool keep) =>
    if not na(st)
        if keep
            if not na(st.tpBox)
                st.tpBox.set_right(math.max(cancelBar, st.tpBox.get_left() + MIN_WIDTH))
                st.tpBox.set_bgcolor(color.new(chart.fg_color, 90))
                st.tpBox.set_border_color(color.new(chart.fg_color, 70))
            if not na(st.slBox)
                st.slBox.set_right(math.max(cancelBar, st.slBox.get_left() + MIN_WIDTH))
                st.slBox.set_bgcolor(color.new(chart.fg_color, 90))
                st.slBox.set_border_color(color.new(chart.fg_color, 70))
            if not na(st.info)
                st.info.set_x(cancelBar)
                st.info.set_textcolor(color.new(chart.fg_color, 45))
            if not na(st.pocLine)
                st.pocLine.set_x2(cancelBar)
                st.pocLine.set_style(line.style_dotted)
                st.pocLine.set_width(1)
        else
            box.delete(st.tpBox)
            box.delete(st.slBox)
            label.delete(st.info)
            if not na(st.pocLine)
                st.pocLine.set_x2(cancelBar)
                st.pocLine.set_style(line.style_dotted)
                st.pocLine.set_width(1)

htfTrend() =>
    int dir = close > ta.ema(close, HTF_LEN) ? 1 : -1
    dir[1]

int   htfDir = nz(request.security(syminfo.tickerid, htfTf, htfTrend(), lookahead = barmerge.lookahead_off), 0)
float atrVal = nz(ta.atr(ATR_LEN), syminfo.mintick)

bool isGap = atrVal > 0 and bar_index > 0 and math.abs(open - nz(close[1], open)) > atrVal * GAP_ATR

bool sessionBreak = session.islastbar or session.islastbar_regular

var array<float> hCache = array.new<float>()
var array<float> lCache = array.new<float>()
var array<float> vCache = array.new<float>()
var array<bool>  gCache = array.new<bool>()

hCache.push(high)
lCache.push(low)
vCache.push(nz(volume, 1.0))
gCache.push(isGap)

if hCache.size() > MAX_LOOKBACK
    hCache.shift()
    lCache.shift()
    vCache.shift()
    gCache.shift()

int cacheFirstBar = bar_index - hCache.size() + 1

var float lastHigh    = na
var int   lastHighBar = na
var bool  highTaken   = true
var float lastLow     = na
var int   lastLowBar  = na
var bool  lowTaken    = true
var int   trendDir    = 0

var int   bullBos     = 0
var int   bearBos     = 0

var int   chochBar    = na
var float trendExt    = na
var int   trendExtBar = na

float ph = ta.pivothigh(high, swingLen, swingLen)
float pl = ta.pivotlow(low, swingLen, swingLen)

if not na(ph)
    lastHigh    := ph
    lastHighBar := bar_index - swingLen
    highTaken   := false

if not na(pl)
    lastLow    := pl
    lastLowBar := bar_index - swingLen
    lowTaken   := false

if trendDir == 1 and (na(trendExt) or high > trendExt)
    trendExt    := high
    trendExtBar := bar_index
if trendDir == -1 and (na(trendExt) or low < trendExt)
    trendExt    := low
    trendExtBar := bar_index

hasGap(int startBar, int endBar) =>
    bool found = false
    int  last  = gCache.size() - 1
    int  i1    = math.max(0, math.min(last, startBar - cacheFirstBar))
    int  i2    = math.max(i1, math.min(last, endBar - cacheFirstBar))
    for i = i1 to i2
        if gCache.get(i)
            found := true
            break
    found

buildProfile(int startBar, int endBar, int rowsN, float vaP) =>
    int last = hCache.size() - 1
    int i1   = math.max(0, math.min(last, startBar - cacheFirstBar))
    int i2   = math.max(i1, math.min(last, endBar - cacheFirstBar))
    float top = hCache.get(i1)
    float bot = lCache.get(i1)
    for i = i1 to i2
        top := math.max(top, hCache.get(i))
        bot := math.min(bot, lCache.get(i))
    float step = (top - bot) / rowsN
    array<float> vols = array.new<float>(rowsN, 0.0)
    if step > 0
        for i = i1 to i2
            int r1 = math.max(0, math.min(rowsN - 1, int(math.floor((lCache.get(i) - bot) / step))))
            int r2 = math.max(0, math.min(rowsN - 1, int(math.floor((hCache.get(i) - bot) / step))))
            float vPer = vCache.get(i) / (r2 - r1 + 1)
            for r = r1 to r2
                vols.set(r, vols.get(r) + vPer)
    float maxVol = vols.max()
    int   pocIdx = math.max(0, vols.indexof(maxVol))
    float target = vols.sum() * vaP / 100.0
    int   up     = pocIdx
    int   dn     = pocIdx
    float acc    = vols.get(pocIdx)
    for _i = 0 to rowsN - 1
        if acc >= target or (up >= rowsN - 1 and dn <= 0)
            break
        float vUp = up < rowsN - 1 ? vols.get(up + 1) : -1.0
        float vDn = dn > 0 ? vols.get(dn - 1) : -1.0
        if vUp >= vDn
            up  += 1
            acc += vUp
        else
            dn  -= 1
            acc += vDn
    float poc = bot + (pocIdx + 0.5) * step
    float vah = bot + (up + 1) * step
    float val = bot + dn * step
    [vols, poc, vah, val, top, bot, step, maxVol, cacheFirstBar + i1, cacheFirstBar + i2]

pocOf(int startBar, int endBar) =>
    [_v, poc, _vah, _val, _t, _b, step, maxVol, _s, _e] = buildProfile(startBar, endBar, rowsCount, vaPercent)
    step > 0 and maxVol > 0 ? poc : na

validSide(int dir, float poc) =>
    bool ok = true
    if useSideFilter
        ok := na(poc) ? false : dir == 1 ? close > poc : close < poc
    ok

var array<Setup> setups = array.new<Setup>()

var float pEntry  = na
var float pTp     = na
var float pSl     = na
var int   pDir    = 0
var int   pBar    = na
var bool  pFilled = false
var Setup pSetup  = na

var int   nSetups  = 0
var int   nWins    = 0
var int   nLoss    = 0
var int   nGapRej  = 0
var int   nSideRej = 0
var int   nVoided  = 0

drawSetup(int dir, int anchorBar, int endBar) =>
    [vols, poc, vah, val, top, bot, step, maxVol, pStart, pEnd] = buildProfile(anchorBar, endBar, rowsCount, vaPercent)
    float entry = na
    float tp    = na
    float sl    = na
    if step > 0 and maxVol > 0
        int   width = math.min(PROFILE_W, math.max(5, pEnd - pStart))
        Setup st    = Setup.new(array.new<box>(), na, na, na, na, na, na, na)
        for i = 0 to rowsCount - 1
            int w = int(math.round(vols.get(i) / maxVol * width))
            if w > 0
                float rTop = bot + (i + 1) * step
                float rBot = bot + i * step
                bool  inVa = rTop <= vah + step * 0.5 and rBot >= val - step * 0.5
                color css  = inVa ? vaCss : rowCss
                st.rows.push(box.new(pStart, rTop, pStart + w, rBot, border_color = color.new(css, 60), bgcolor = color.new(css, inVa ? 35 : 55)))
        st.frame := box.new(pStart, top, pEnd, bot, border_color = color.new(chart.fg_color, 60), bgcolor = color.new(chart.fg_color, 95))
        entry := poc
        tp    := tpMode == "Value Area" ? (dir == 1 ? vah : val) : (dir == 1 ? poc + atrVal * tpMult : poc - atrVal * tpMult)
        sl    := dir == 1 ? poc - atrVal * slMult : poc + atrVal * slMult
        color dirCss = dir == 1 ? bullCss : bearCss
        st.pocLine := line.new(pStart, entry, bar_index + PROJECTION, entry, color = chart.fg_color, width = 2)
        st.vahLine := line.new(pStart, vah, bar_index, vah, color = color.new(chart.fg_color, 30), style = line.style_dotted)
        st.valLine := line.new(pStart, val, bar_index, val, color = color.new(chart.fg_color, 30), style = line.style_dotted)
        st.tpBox   := box.new(bar_index, tp, bar_index + PROJECTION, entry, border_color = color.new(bullCss, 20), bgcolor = color.new(bullCss, 70))
        st.slBox   := box.new(bar_index, entry, bar_index + PROJECTION, sl, border_color = color.new(bearCss, 20), bgcolor = color.new(bearCss, 70))
        float rr = math.abs(sl - entry) > 0 ? math.abs(tp - entry) / math.abs(sl - entry) : na
        st.info := label.new(bar_index + PROJECTION, tp, (dir == 1 ? "LONG" : "SHORT") + "  ·  R:R " + str.tostring(rr, "#.##"), style = label.style_label_down, color = #00000000, textcolor = dirCss, size = size.small)
        setups.push(st)
        if setups.size() > maxProfiles
            Setup aged = setups.get(setups.size() - 1 - maxProfiles)
            aged.clearRows()
        while setups.size() > maxSetups
            Setup old = setups.shift()
            old.destroy()
    [entry, tp, sl]

bool bullBreak = not na(lastHigh) and not highTaken and close > lastHigh
bool bearBreak = not na(lastLow) and not lowTaken and close < lastLow

bool longSignal  = false
bool shortSignal = false
bool chochEvent  = false
int  sigStart    = na
int  sigEnd      = na

bool canArm = pDir == 0 and not (useGapFilter and (sessionBreak or isGap))

if bullBreak
    highTaken := true
    bool isBos = trendDir == 1
    if showStructure
        line.new(lastHighBar, lastHigh, bar_index, lastHigh, color = color.new(bullCss, 40), style = line.style_dashed)
        label.new(int(math.avg(lastHighBar, bar_index)), lastHigh, isBos ? "BOS" : "CHoCH", style = label.style_label_down, color = #00000000, textcolor = bullCss, size = size.tiny)
    if isBos
        bullBos += 1
    else
        if bearBos >= bosRequired and (not useHtf or htfDir == -1) and not na(chochBar) and canArm
            int s0 = chochBar
            int e0 = nz(trendExtBar, bar_index)
            if useGapFilter and hasGap(s0, e0)
                nGapRej += 1
            else if not validSide(-1, pocOf(s0, e0))
                nSideRej += 1
            else
                shortSignal := true
                sigStart    := s0
                sigEnd      := e0
        chochEvent  := true
        bearBos     := 0
        bullBos     := 0
        trendDir    := 1
        chochBar    := bar_index
        trendExt    := high
        trendExtBar := bar_index

if bearBreak
    lowTaken := true
    bool isBos = trendDir == -1
    if showStructure
        line.new(lastLowBar, lastLow, bar_index, lastLow, color = color.new(bearCss, 40), style = line.style_dashed)
        label.new(int(math.avg(lastLowBar, bar_index)), lastLow, isBos ? "BOS" : "CHoCH", style = label.style_label_up, color = #00000000, textcolor = bearCss, size = size.tiny)
    if isBos
        bearBos += 1
    else
        if bullBos >= bosRequired and (not useHtf or htfDir == 1) and not na(chochBar) and canArm
            int s0 = chochBar
            int e0 = nz(trendExtBar, bar_index)
            if useGapFilter and hasGap(s0, e0)
                nGapRej += 1
            else if not validSide(1, pocOf(s0, e0))
                nSideRej += 1
            else
                longSignal := true
                sigStart   := s0
                sigEnd     := e0
        chochEvent  := true
        bullBos     := 0
        bearBos     := 0
        trendDir    := -1
        chochBar    := bar_index
        trendExt    := low
        trendExtBar := bar_index

bool setupVoided = false
bool gapVoid     = useGapFilter and (sessionBreak or isGap)
bool chochVoid   = voidOnChoch and chochEvent
bool expiryVoid  = pendingExpiry > 0 and not na(pBar) and bar_index - pBar >= pendingExpiry

if (chochVoid or gapVoid or expiryVoid) and pDir != 0 and not pFilled
    if not na(pSetup)
        pSetup.cancel(bar_index, showCancelled)
    pSetup      := na
    pDir        := 0
    setupVoided := true
    nVoided     += 1

if longSignal or shortSignal
    int dir = longSignal ? 1 : -1
    [e, t, x] = drawSetup(dir, nz(sigStart, bar_index), nz(sigEnd, bar_index))
    if not na(e)
        pEntry  := e
        pTp     := t
        pSl     := x
        pDir    := dir
        pBar    := bar_index
        pFilled := false
        pSetup  := setups.size() > 0 ? setups.get(setups.size() - 1) : na
        nSetups += 1

bool entryFilled = false
bool tpHit       = false
bool slHit       = false

if pDir != 0 and not na(pEntry)
    if not pFilled
        if low <= pEntry and high >= pEntry
            pFilled     := true
            entryFilled := true
            if not na(pSetup)
                if not na(pSetup.tpBox)
                    pSetup.tpBox.set_left(bar_index)
                    pSetup.tpBox.set_right(bar_index + PROJECTION)
                if not na(pSetup.slBox)
                    pSetup.slBox.set_left(bar_index)
                    pSetup.slBox.set_right(bar_index + PROJECTION)
                if not na(pSetup.info)
                    pSetup.info.set_x(bar_index + PROJECTION)
        else if not na(pSetup)
            if not na(pSetup.pocLine)
                pSetup.pocLine.set_x2(bar_index + 2)
            if not na(pSetup.tpBox)
                pSetup.tpBox.set_left(bar_index)
                pSetup.tpBox.set_right(bar_index + PROJECTION)
            if not na(pSetup.slBox)
                pSetup.slBox.set_left(bar_index)
                pSetup.slBox.set_right(bar_index + PROJECTION)
            if not na(pSetup.info)
                pSetup.info.set_x(bar_index + PROJECTION)
    if pFilled
        if pDir == 1
            if low <= pSl
                slHit := true
            else if high >= pTp
                tpHit := true
        else
            if high >= pSl
                slHit := true
            else if low <= pTp
                tpHit := true
    if tpHit or slHit
        nWins  += tpHit ? 1 : 0
        nLoss  += slHit ? 1 : 0
        if not na(pSetup)
            if not na(pSetup.tpBox)
                pSetup.tpBox.set_right(math.max(bar_index, pSetup.tpBox.get_left() + MIN_WIDTH))
            if not na(pSetup.slBox)
                pSetup.slBox.set_right(math.max(bar_index, pSetup.slBox.get_left() + MIN_WIDTH))
            if not na(pSetup.info)
                pSetup.info.set_x(bar_index)
        pDir    := 0
        pFilled := false
        pSetup  := na

var table statsTable = table.new(position.top_right, 2, 6, bgcolor = color.new(chart.bg_color, 20), border_color = color.new(chart.fg_color, 80), border_width = 1)
if showStats and barstate.islast
    float winRate = nWins + nLoss > 0 ? nWins / (nWins + nLoss) * 100 : na
    statsTable.cell(0, 0, "Setups", text_color = chart.fg_color, text_size = size.small)
    statsTable.cell(1, 0, str.tostring(nSetups), text_color = chart.fg_color, text_size = size.small)
    statsTable.cell(0, 1, "Targets", text_color = chart.fg_color, text_size = size.small)
    statsTable.cell(1, 1, str.tostring(nWins), text_color = bullCss, text_size = size.small)
    statsTable.cell(0, 2, "Stops", text_color = chart.fg_color, text_size = size.small)
    statsTable.cell(1, 2, str.tostring(nLoss), text_color = bearCss, text_size = size.small)
    statsTable.cell(0, 3, "Win Rate", text_color = chart.fg_color, text_size = size.small)
    statsTable.cell(1, 3, na(winRate) ? "n/a" : str.tostring(winRate, "#.#") + "%", text_color = chart.fg_color, text_size = size.small)
    statsTable.cell(0, 4, "Cancelled", text_color = chart.fg_color, text_size = size.small)
    statsTable.cell(1, 4, str.tostring(nVoided), text_color = color.new(chart.fg_color, 30), text_size = size.small)
    statsTable.cell(0, 5, "HTF Trend", text_color = chart.fg_color, text_size = size.small)
    statsTable.cell(1, 5, not useHtf ? "Off" : htfDir == 1 ? "Bullish" : "Bearish", text_color = not useHtf ? chart.fg_color : htfDir == 1 ? bullCss : bearCss, text_size = size.small)

alertcondition(longSignal, "Long Setup", "Bullish volume profile setup detected")
alertcondition(shortSignal, "Short Setup", "Bearish volume profile setup detected")
alertcondition(entryFilled, "Entry Triggered", "Price reached the POC entry level")
alertcondition(tpHit, "Target Reached", "Setup reached its target")
alertcondition(slHit, "Stop Reached", "Setup reached its stop")
alertcondition(setupVoided, "Setup Cancelled", "Pending setup cancelled before the entry was reached")

// ===== SMC: Order Blocks + FVG (regras do LuxAlgo Smart Money Concepts, simplificadas) =====
const string GRP_SMC = "SMC (OB + FVG)"
showOB     = input.bool(true, "Mostrar Order Blocks", group = GRP_SMC)
showFVG    = input.bool(true, "Mostrar FVG", group = GRP_SMC)
maxOB      = input.int(4, "Order Blocks por lado", minval = 1, maxval = 20, group = GRP_SMC)
maxFVG     = input.int(8, "FVGs abertos no grafico", minval = 1, maxval = 40, group = GRP_SMC)
obBullCss  = input.color(color.new(#089981, 75), "OB demanda", inline = "ob", group = GRP_SMC)
obBearCss  = input.color(color.new(#f23645, 75), "OB oferta", inline = "ob", group = GRP_SMC)
fvgBullCss = input.color(color.new(#2962ff, 80), "FVG alta", inline = "fvg", group = GRP_SMC)
fvgBearCss = input.color(color.new(#ff9800, 80), "FVG baixa", inline = "fvg", group = GRP_SMC)

type Zone
    box    bx
    line   mid
    float  top
    float  bot
    int    dir
    int    born
    int    touches
    string kind

var array<Zone> obZones  = array.new<Zone>()
var array<Zone> fvgZones = array.new<Zone>()

cacheIdx(int bar) => math.max(0, math.min(hCache.size() - 1, bar - cacheFirstBar))

countDir(array<Zone> arr, int d) =>
    int n = 0
    if arr.size() > 0
        for i = 0 to arr.size() - 1
            if arr.get(i).dir == d
                n += 1
    n

dropOldest(array<Zone> arr, int d) =>
    int idx = -1
    if arr.size() > 0
        for i = 0 to arr.size() - 1
            if arr.get(i).dir == d
                idx := i
                break
    if idx >= 0
        Zone z = arr.remove(idx)
        box.delete(z.bx)
        line.delete(z.mid)

float hPrev = nz(high[1], high)
float lPrev = nz(low[1], low)

updateZones(array<Zone> arr, bool isOB) =>
    int removed = 0
    if arr.size() > 0
        for i = arr.size() - 1 to 0
            Zone z = arr.get(i)
            bool gone = isOB ? (z.dir == 1 ? close < z.bot : close > z.top) : (z.dir == 1 ? low < z.bot : high > z.top)
            if gone
                box.delete(z.bx)
                line.delete(z.mid)
                arr.remove(i)
                removed += 1
            if not gone
                bool inNow  = high >= z.bot and low <= z.top
                bool inPrev = hPrev >= z.bot and lPrev <= z.top
                if inNow and not inPrev and bar_index > z.born
                    z.touches += 1
                z.bx.set_right(bar_index + 5)
                if not na(z.mid)
                    z.mid.set_x2(bar_index + 5)
    removed

updateZones(obZones, true)
updateZones(fvgZones, false)

if showOB and bullBreak and not na(lastHighBar)
    int i1 = cacheIdx(lastHighBar)
    int i2 = cacheIdx(bar_index - 1)
    if i2 >= i1
        int k = i1
        for i = i1 to i2
            if lCache.get(i) < lCache.get(k)
                k := i
        float zt = hCache.get(k)
        float zb = lCache.get(k)
        obZones.push(Zone.new(box.new(cacheFirstBar + k, zt, bar_index + 5, zb, border_color = color.new(#089981, 40), bgcolor = obBullCss, text = "OB demanda", text_color = color.new(#089981, 0), text_size = size.tiny, text_halign = text.align_right, text_valign = text.align_bottom), na, zt, zb, 1, bar_index, 0, "OB"))
        if countDir(obZones, 1) > maxOB
            dropOldest(obZones, 1)

if showOB and bearBreak and not na(lastLowBar)
    int i1 = cacheIdx(lastLowBar)
    int i2 = cacheIdx(bar_index - 1)
    if i2 >= i1
        int k = i1
        for i = i1 to i2
            if hCache.get(i) > hCache.get(k)
                k := i
        float zt = hCache.get(k)
        float zb = lCache.get(k)
        obZones.push(Zone.new(box.new(cacheFirstBar + k, zt, bar_index + 5, zb, border_color = color.new(#f23645, 40), bgcolor = obBearCss, text = "OB oferta", text_color = color.new(#f23645, 0), text_size = size.tiny, text_halign = text.align_right, text_valign = text.align_top), na, zt, zb, -1, bar_index, 0, "OB"))
        if countDir(obZones, -1) > maxOB
            dropOldest(obZones, -1)

var float cumBody = 0.0
float bodyPrev = nz((close[1] - open[1]) / (open[1] * 100))
cumBody += math.abs(bodyPrev)
float bodyThr = cumBody / (bar_index + 1) * 2
bool fvgUp = bar_index > 2 and low > high[2] and close[1] > high[2] and bodyPrev > bodyThr
bool fvgDn = bar_index > 2 and high < low[2] and close[1] < low[2] and -bodyPrev > bodyThr

if showFVG and fvgUp
    float m = (low + high[2]) / 2
    fvgZones.push(Zone.new(box.new(bar_index - 2, low, bar_index + 5, high[2], border_color = color.new(#2962ff, 50), bgcolor = fvgBullCss, text = "FVG", text_color = color.new(#2962ff, 0), text_size = size.tiny, text_halign = text.align_right), line.new(bar_index - 2, m, bar_index + 5, m, color = color.new(#2962ff, 20), style = line.style_dotted), low, high[2], 1, bar_index, 0, "FVG"))
if showFVG and fvgDn
    float m = (low[2] + high) / 2
    fvgZones.push(Zone.new(box.new(bar_index - 2, low[2], bar_index + 5, high, border_color = color.new(#ff9800, 50), bgcolor = fvgBearCss, text = "FVG", text_color = color.new(#ff9800, 0), text_size = size.tiny, text_halign = text.align_right), line.new(bar_index - 2, m, bar_index + 5, m, color = color.new(#ff9800, 20), style = line.style_dotted), low[2], high, -1, bar_index, 0, "FVG"))
while fvgZones.size() > maxFVG
    Zone z = fvgZones.shift()
    box.delete(z.bx)
    line.delete(z.mid)

// ===== AVALIACAO DAS ZONAS: oferta mais proxima acima e demanda mais proxima abaixo, 7 criterios =====
// Nao ve macro nem gatilho M5: o Claude confere isso na ficha pre-entrada (docs/ficha-pre-entrada.md).
const string GRP_EVAL = "Avaliacao das zonas"
showEval = input.bool(true, "Mostrar avaliacao das zonas", group = GRP_EVAL)
minRR    = input.float(1.5, "R:R minimo", minval = 0.5, step = 0.1, group = GRP_EVAL)
evalPos  = input.string("Inferior esquerda", "Posicao", options = ["Inferior esquerda", "Superior esquerda", "Inferior direita", "Superior direita"], group = GRP_EVAL)

int nyKey  = year(time, "America/New_York") * 10000 + month(time, "America/New_York") * 100 + dayofmonth(time, "America/New_York")
int nyMinT = hour(time, "America/New_York") * 60 + minute(time, "America/New_York")
bool nyNew = nyKey != nz(nyKey[1])
bool nyOpenBar = nyMinT >= 570 and (nz(nyMinT[1]) < 570 or nyNew)
float vVol = nz(volume, 1.0) > 0 ? nz(volume, 1.0) : 1.0
var float vwSv = 0.0
var float vwSp = 0.0
if nyOpenBar
    vwSv := 0.0
    vwSp := 0.0
vwSv += vVol
vwSp += hlc3 * vVol
float vwNY = vwSp / vwSv
var float dHi = na
var float dLo = na
if nyNew or na(dHi)
    dHi := high
    dLo := low
else
    dHi := math.max(dHi, high)
    dLo := math.min(dLo, low)

zDist(Zone z, bool supply) => na(z) ? 1e10 : supply ? math.max(0.0, z.bot - close) : math.max(0.0, close - z.top)

pickZone(array<Zone> arr, bool supply, Zone cur) =>
    Zone best = cur
    if arr.size() > 0
        for i = 0 to arr.size() - 1
            Zone z = arr.get(i)
            bool ok = supply ? (z.dir == -1 and z.top >= close) : (z.dir == 1 and z.bot <= close)
            if ok and zDist(z, supply) < zDist(best, supply)
                best := z
    best

overlaps(array<Zone> arr, Zone z) =>
    bool f = false
    if not na(z) and arr.size() > 0
        for i = 0 to arr.size() - 1
            Zone o = arr.get(i)
            if o.dir == z.dir and o.bot <= z.top and o.top >= z.bot
                f := true
                break
    f

var table evalTbl = table.new(evalPos == "Inferior esquerda" ? position.bottom_left : evalPos == "Superior esquerda" ? position.top_left : evalPos == "Inferior direita" ? position.bottom_right : position.top_right, 3, 12, bgcolor = color.new(color.black, 10), border_width = 1, border_color = color.new(color.gray, 70), frame_width = 1, frame_color = color.new(color.gray, 40))

f_ec(int r, int c, string txt, color tc, color bg) => table.cell(evalTbl, c, r, txt, text_color = tc, bgcolor = bg, text_size = size.small, text_halign = c == 0 ? text.align_left : text.align_center)
f_ok(int r, int c, bool ok, string txt) => f_ec(r, c, (ok ? "✓ " : "✗ ") + txt, color.white, ok ? color.new(#089981, 30) : color.new(#f23645, 35))

if showEval and barstate.islast
    Zone sz = pickZone(fvgZones, true, pickZone(obZones, true, na))
    Zone dz = pickZone(fvgZones, false, pickZone(obZones, false, na))
    f_ec(0, 0, "AVALIACAO DAS ZONAS", color.yellow, color.new(color.gray, 65))
    f_ec(0, 1, "OFERTA ▼ (venda)", color.white, color.new(#f23645, 50))
    f_ec(0, 2, "DEMANDA ▲ (compra)", color.white, color.new(#089981, 50))
    rows = array.from("Zona", "Distancia", "Estrutura a favor", "Premio / desconto do dia", "Lado do VWAP NY", "Confluencia OB + FVG", "1o toque", "Liquidez alem da zona", "R:R ate o alvo", "VEREDITO")
    for r = 0 to 9
        f_ec(r + 1, 0, rows.get(r), color.white, color.new(color.black, 10))
    for c = 1 to 2
        bool supply = c == 1
        Zone z = supply ? sz : dz
        if na(z)
            f_ec(1, c, "nenhuma zona aberta", color.gray, color.new(color.black, 10))
            for r = 2 to 10
                f_ec(r, c, "—", color.gray, color.new(color.black, 10))
        if not na(z)
            float rng = math.max(dHi - dLo, syminfo.mintick)
            float zMid = (z.top + z.bot) / 2
            float pos = (zMid - dLo) / rng
            bool inside = close >= z.bot and close <= z.top
            float dist = supply ? z.bot - close : close - z.top
            bool cEstr = supply ? trendDir == -1 : trendDir == 1
            bool cPrem = supply ? pos >= 0.5 : pos <= 0.5
            bool cVwap = supply ? z.bot >= vwNY : z.top <= vwNY
            bool cConf = overlaps(z.kind == "OB" ? fvgZones : obZones, z)
            bool cFresh = z.touches == 0 or (z.touches == 1 and inside)
            bool liqBeyond = supply ? (not highTaken and lastHigh > z.top and lastHigh <= z.top + 1.5 * atrVal) : (not lowTaken and lastLow < z.bot and lastLow >= z.bot - 1.5 * atrVal)
            Zone opp = supply ? dz : sz
            float entry = supply ? z.bot : z.top
            float stop  = supply ? z.top + 0.5 * atrVal : z.bot - 0.5 * atrVal
            float tgt   = supply ? (not na(opp) and opp.top < entry ? opp.top : dLo) : (not na(opp) and opp.bot > entry ? opp.bot : dHi)
            float risk  = math.abs(stop - entry)
            float rr    = risk > 0 ? math.abs(entry - tgt) / risk : na
            bool cRR = not na(rr) and rr >= minRR
            int score = (cEstr ? 1 : 0) + (cPrem ? 1 : 0) + (cVwap ? 1 : 0) + (cConf ? 1 : 0) + (cFresh ? 1 : 0) + (liqBeyond ? 0 : 1) + (cRR ? 1 : 0)
            f_ec(1, c, z.kind + " " + str.tostring(z.bot, "#") + "–" + str.tostring(z.top, "#"), color.white, color.new(color.black, 10))
            f_ec(2, c, inside ? "PRECO DENTRO" : (supply ? "+" : "-") + str.tostring(dist, "#") + " pts (" + str.tostring(dist / atrVal, "#.#") + " ATR)", inside ? color.yellow : color.white, color.new(color.black, 10))
            f_ok(3, c, cEstr, trendDir == 1 ? "estrutura ALTA" : trendDir == -1 ? "estrutura BAIXA" : "indefinida")
            f_ok(4, c, cPrem, (supply ? "premio " : "desconto ") + str.tostring(pos * 100, "#") + "%")
            f_ok(5, c, cVwap, (supply ? "acima" : "abaixo") + " do VWAP " + str.tostring(vwNY, "#"))
            f_ok(6, c, cConf, cConf ? "OB e FVG juntos" : "zona isolada")
            f_ok(7, c, cFresh, cFresh ? "zona nova" : "ja tocada " + str.tostring(z.touches) + "x")
            f_ok(8, c, not liqBeyond, liqBeyond ? (supply ? "topo " + str.tostring(lastHigh, "#") + " logo acima" : "fundo " + str.tostring(lastLow, "#") + " logo abaixo") : "sem liquidez colada")
            f_ok(9, c, cRR, na(rr) ? "sem alvo" : "R:R " + str.tostring(rr, "#.#") + " (alvo " + str.tostring(tgt, "#") + ")")
            string verd = score >= 5 ? "BOA " : score >= 3 ? "MEDIA " : "FRACA "
            color vbg = score >= 5 ? color.new(#089981, 15) : score >= 3 ? color.new(color.gray, 40) : color.new(#f23645, 20)
            f_ec(10, c, verd + str.tostring(score) + "/7", color.white, vbg)
    f_ec(11, 0, "Falta: macro (painel) + gatilho M5 fechado", color.gray, color.new(color.black, 10))
